# Copie para .env e preencha. O .env nunca vai para o Git.

# --- Obrigatórias ----------------------------------------------------------
ONM_EMAIL=
ONM_PASSWORD=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Filtro ----------------------------------------------------------------
# Sem a chave do Gemini o bot notifica TUDO (fallback seguro, nunca cala).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Vaga que o classificador marcou como "talvez" também vai para o grupo, com 🤔.
NOTIFICAR_TALVEZ=true

# --- Contato direto --------------------------------------------------------
# A regra do grupo: só entra vaga que dá para responder fora da plataforma.
EXIGIR_CONTATO=true
# Tire `email` para deixar só WhatsApp e link. `instagram` não conta por padrão.
CONTATOS_ACEITOS=whatsapp,telefone,link,email

# --- Vaga encerrada --------------------------------------------------------
# marcar | apagar | nada
ACAO_VAGA_ENCERRADA=marcar
RECHECK_HORAS=6
RECHECK_POR_CICLO=12
RECHECK_DIAS=30

# --- Ritmo e formato -------------------------------------------------------
CHECK_INTERVAL=600
PAGE_LIMIT=20
DESCRIPTION_MAX_CHARS=700
LOG_LEVEL=INFO

# DATA_DIR só em produção, e já vem fixo no docker-compose.yml apontando para o
# volume. Não cadastre no painel do Coolify.
